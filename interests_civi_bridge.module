<?php

use Drupal\Core\Entity\EntityInterface;
use Drupal\node\NodeInterface;
use Drupal\profile\Entity\ProfileInterface;

/**
 * Node id of the onboarding "thank you / getting started" page
 * (/thank-you-joining-makehaven). Shared lineage keeps this stable across envs.
 */
const INTERESTS_CIVI_BRIDGE_THANKYOU_NID = 614;

/**
 * Implements hook_node_view().
 *
 * Injects the Areas-of-Interest picker at the top of the onboarding thank-you
 * page for logged-in members, so we capture interests at the end of signup
 * (drives Slack routing + the weekly digest) without lengthening the join form.
 * Rendered in the normal page pipeline (not via a body token) so the form
 * submits and saves properly.
 */
function interests_civi_bridge_node_view(array &$build, NodeInterface $node, $display, $view_mode): void {
  if ((int) $node->id() !== INTERESTS_CIVI_BRIDGE_THANKYOU_NID || $view_mode !== 'full') {
    return;
  }
  if (!\Drupal::currentUser()->isAuthenticated()) {
    return;
  }
  $build['interests_picker'] = [
    '#type' => 'container',
    '#weight' => -50,
    '#attributes' => ['class' => ['mh-interest-picker-wrap']],
    '#attached' => ['library' => ['interests_civi_bridge/interest_picker']],
    'heading' => [
      '#markup' => '<h3 class="mh-interest-picker-heading">' . t('What are you interested in?') . '</h3>',
    ],
    'form' => \Drupal::formBuilder()->getForm('Drupal\interests_civi_bridge\Form\InterestPickerForm'),
  ];

  // Recommendations for the member's saved interests — shown after they save
  // (the save reloads the page, so the picks are reflected here). Projects are
  // cleanly interest-tagged today; tools + badges need interest-tagging first
  // (see docs/proposals/INTERACTIVE_ONBOARDING_INTERESTS_PLAN.md §6).
  $recs = _interests_civi_bridge_interest_recommendations();
  if ($recs) {
    $build['interests_recommendations'] = $recs + ['#weight' => -49];
  }

  // The picker + recommendations reflect per-user saved interests.
  $build['#cache']['contexts'][] = 'user';
}

/**
 * Build the "for your interests" recommendation cards (projects for now).
 *
 * Defensive: any failure returns an empty array so the thank-you page never
 * breaks for a member.
 */
function _interests_civi_bridge_interest_recommendations(): array {
  try {
    $account = \Drupal::currentUser();
    $etm = \Drupal::entityTypeManager();
    $user = \Drupal\user\Entity\User::load($account->id());
    if (!$user) {
      return [];
    }
    $profile = $etm->getStorage('profile')->loadByUser($user, 'main');
    if (!$profile || !$profile->hasField('field_member_areas_interest')) {
      return [];
    }
    $tids = [];
    foreach ($profile->get('field_member_areas_interest') as $item) {
      if (!empty($item->target_id)) {
        $tids[] = (int) $item->target_id;
      }
    }
    if (!$tids) {
      return [];
    }
    // Broaden to children so a parent-category pick still matches child-tagged
    // projects.
    $term_storage = $etm->getStorage('taxonomy_term');
    $expanded = $tids;
    foreach ($tids as $tid) {
      foreach ($term_storage->loadTree('area_of_interest', $tid) as $child) {
        $expanded[] = (int) $child->tid;
      }
    }
    $expanded = array_values(array_unique($expanded));

    $nids = $etm->getStorage('node')->getQuery()
      ->condition('type', 'project')
      ->condition('status', 1)
      ->condition('field_project_area_of_interest', $expanded, 'IN')
      ->range(0, 6)
      ->accessCheck(TRUE)
      ->execute();
    if (!$nids) {
      return [];
    }
    $nodes = $etm->getStorage('node')->loadMultiple($nids);
    $flag_builder = \Drupal::hasService('flag.link_builder') ? \Drupal::service('flag.link_builder') : NULL;
    $cards = [];
    foreach ($nodes as $node) {
      $image = [];
      if ($node->hasField('field_project_completed_image') && !$node->get('field_project_completed_image')->isEmpty()) {
        $file = $node->get('field_project_completed_image')->entity;
        if ($file) {
          $image = [
            '#theme' => 'image_style',
            '#style_name' => 'medium',
            '#uri' => $file->getFileUri(),
            '#alt' => $node->label(),
          ];
        }
      }
      $star = [];
      if ($flag_builder) {
        try {
          $star = $flag_builder->build('node', $node->id(), 'want_to_make');
        }
        catch (\Exception $e) {
          $star = [];
        }
      }
      $cards[] = [
        '#type' => 'container',
        '#attributes' => ['class' => ['mh-rec-card']],
        'image' => $image,
        'title' => [
          '#type' => 'link',
          '#title' => $node->label(),
          '#url' => $node->toUrl(),
          '#attributes' => ['class' => ['mh-rec-card__title']],
        ],
        'star' => $star ? ['#type' => 'container', '#attributes' => ['class' => ['mh-rec-card__star']]] + ['flag' => $star] : [],
      ];
    }
    if (!$cards) {
      return [];
    }
    return [
      '#type' => 'container',
      '#attributes' => ['class' => ['mh-interest-recs']],
      '#attached' => ['library' => ['interests_civi_bridge/interest_picker']],
      'heading' => [
        '#markup' => '<h3 class="mh-interest-recs__heading">' . t('Projects for your interests') . '</h3>'
          . '<p class="mh-interest-recs__intro">' . t('Star any you want to make — they save to your profile.') . '</p>',
      ],
      'cards' => ['#type' => 'container', '#attributes' => ['class' => ['mh-rec-grid']]] + $cards,
    ];
  }
  catch (\Exception $e) {
    \Drupal::logger('interests_civi_bridge')->warning('interest recommendations failed: @m', ['@m' => $e->getMessage()]);
    return [];
  }
}

/**
 * Implements hook_entity_insert().
 */
function interests_civi_bridge_entity_insert(EntityInterface $entity): void {
  if ($entity instanceof ProfileInterface) {
    \Drupal::service('interests_civi_bridge.sync_manager')->handleProfileSave($entity, TRUE);
  }
}

/**
 * Implements hook_entity_update().
 */
function interests_civi_bridge_entity_update(EntityInterface $entity): void {
  if ($entity instanceof ProfileInterface) {
    \Drupal::service('interests_civi_bridge.sync_manager')->handleProfileSave($entity, FALSE);
  }
}

/**
 * Implements hook_civicrm_post().
 */
function interests_civi_bridge_civicrm_post($op, $objectName, $objectId, &$objectRef): void {
  if (!in_array($op, ['create', 'edit'], TRUE)) {
    return;
  }
  if ($objectName !== 'Contact' || !$objectId) {
    return;
  }
  \Drupal::service('interests_civi_bridge.sync_manager')->handleCivicrmPost((int) $objectId);
}
